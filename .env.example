# Core API / DB settings
# GOOGLE_API_KEY is still needed for answer generation (Gemini Flash),
# but not for embeddings when using the local embedding model below.
GOOGLE_API_KEY=your_google_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Optional Gemini model overrides
LLM_MODEL=gemini-flash-latest
ROUTER_MODEL=gemini-flash-latest
GUARDRAIL_MODEL=gemini-flash-latest

# Local embedding model used by ingestion/retrieval
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# Embedding batching controls (local model)
EMBEDDING_BATCH_SIZE=100
EMBEDDING_LOCAL_ENCODE_BATCH_SIZE=64
EMBEDDING_BATCH_CHAR_BUDGET=300000
EMBEDDING_BETWEEN_BATCH_DELAY=0.0
EMBEDDING_RETRY_MIN_DELAY=3
EMBEDDING_BATCH_MAX_ATTEMPTS=3

# Gemini Flash limits (generation only)
GEMINI_FLASH_RPM=5
GEMINI_FLASH_RPM_HEADROOM=0.90
GEMINI_FLASH_TPM=250000
GEMINI_FLASH_RPD=20

# Optional path for persisted quota state
# GEMINI_RATE_STATE_FILE=/absolute/path/to/.gemini_rate_state.json
